{
  "$schema": "https://antigravity.google/schemas/v1/settings.json",
  "agentMode": "accept-edits",
  "allowNonWorkspaceAccess": true,
  "colorScheme": "terminal",
  "copyOnSelect": false,
  "historySize": -1,
  "model": "Orchestrator (Carbon)",
  "permissions": {
    "allow": [
      "command(cargo test)",
      "command(cargo build)",
      "command(cargo clippy)",
      "command(cargo fmt)",
      "command(cargo check)",
      "command(cargo run)",
      "command(cargo doc)",
      "command(go test)",
      "command(go build)",
      "command(go vet)",
      "command(go mod tidy)",
      "command(dart test)",
      "command(dart analyze)",
      "command(dart compile)",
      "command(dart format)",
      "command(dart --version)",
      "command(dart fix --dry-run)",
      "command(dart pub run build_runner)",
      "command(dart run build_runner)",
      "command(protoc-gen-dart)",
      "command(flutter test)",
      "command(flutter analyze)",
      "command(flutter build)",
      "command(flutter create)",
      "command(flutter --version)",
      "command(flutter pub get)",
      "command(flutter pub run build_runner build --delete-conflicting-outputs)",
      "command(flutter gen-l10n)",
      "command(node --test)",
      "command(npm test)",
      "command(npm run test)",
      "command(npm run build)",
      "command(npm run lint)",
      "command(npm run typecheck)",
      "command(npm run check)",
      "command(bun test)",
      "command(bun run)",
      "command(bunx better-icons)",
      "command(make check)",
      "command(make test)",
      "command(make ci)",
      "command(conda create)",
      "command(conda run)",
      "command(conda activate)",
      "command(deactivate)",
      "command(coderabbit review --prompt-only)",
      "command(git add)",
      "command(git commit)",
      "command(git fetch)",
      "command(git pull)",
      "command(git merge)",
      "command(git submodule add)",
      "command(git submodule update --init)",
      "command(git log)",
      "command(git show)",
      "command(git diff)",
      "command(git status)",
      "command(git rev-list)",
      "command(gh pr view)",
      "command(gh pr checks)",
      "command(gh pr status)",
      "command(gh run view)",
      "command(gh auth status)",
      "command(grep)",
      "command(rg)",
      "command(sed -n)",
      "command(nm)",
      "command(otool)",
      "command(wc)",
      "command(du)",
      "command(xcrun)",
      "command(clang++)",
      "command(echo)",
      "command(cd)",
      "read_url(*)",
      "mcp(dart/*)",
      "mcp(exa/*)"
    ],
    "ask": [
      "command(gh pr comment)",
      "command(gh pr review)",
      "command(gh issue comment)"
    ],
    "deny": [
      "command(git push -f)",
      "command(git push --force)",
      "command(git push --force-with-lease)",
      "command(regex:git push .+ (--force|-f|--force-with-lease).*)",
      "command(regex:git push (--force|-f|--force-with-lease) .+)"
    ]
  },
  "showFeedbackSurvey": false,
  "showTips": false,
  "statusLine": {
    "type": "command",
    "command": "sh \"$HOME/.gemini/antigravity-cli/statusline-command.sh\"",
    "enabled": true,
    "padding": 0,
    "stack_with_default": false
  },
  "title": {
    "enabled": false
  },
  "trustedWorkspaces": [
    "/Users/lk/agents-workspace",
    "/Users/lk/proj/aime",
    "/Users/lk/proj",
    "/Users/lk/proj/server_box",
    "/Users/lk/proj/gaudi2",
    "/Users/lk/proj/backend.rs",
    "/Users/lk/ipa",
    "/Users/lk/proj/unseen",
    "/Users/lk/proj/self-model",
    "/Users/lk/proj/dotfiles",
    "/Users/lk/proj/flutter_server_box"
  ]
}
